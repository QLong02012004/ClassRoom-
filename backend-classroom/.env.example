# ==========================================
# CẤU HÌNH SERVER
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==========================================
# 1. DATABASE MONGODB
# ==========================================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.vhadf24.mongodb.net/test?retryWrites=true&w=majority&appName=Cluster0&tls=true

# ==========================================
# 2. BẢO MẬT & JWT AUTHENTICATION
# ==========================================
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# 3. SUPABASE CLOUD STORAGE
# ==========================================
SUPABASE_URL=https://your-supabase-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# ==========================================
# 4. GEMINI AI API
# ==========================================
GEMINI_API_KEY=your_gemini_api_key

# ==========================================
# 5. GOOGLE OAUTH 2.0
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==========================================
# 6. GỬI EMAIL OTP / XÁC THỰC TÀI KHOẢN (GMAIL SMTP)
# ==========================================
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
